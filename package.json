{
  "name": "hub-to-learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "dev": "npm --workspace @hubtolearn/artifact-studio run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:links": "node scripts/check-links.mjs",
    "check:privacy": "node scripts/check-private-boundary.mjs",
    "check:writing": "node scripts/check-writing.mjs",
    "check": "npm run check:privacy && npm run check:links && npm run check:writing && npm run test && npm run build",
    "verify:artifact": "node scripts/verify-artifact.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

